# Dán API key Claude của bạn vào đây (lấy tại https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=
# Tùy chọn
ANNA_PORT=3700
ANNA_MODEL=claude-opus-5-5
# Giọng: vi-VN-HoaiMyNeural (nữ) hoặc vi-VN-NamMinhNeural (nam)
ANNA_VOICE=vi-VN-NamMinhNeural
ANNA_VOICE_RATE=-4%
ANNA_VOICE_PITCH=-14Hz
# edge = giọng Microsoft online (tự nhiên, chậm 4-11s/câu)
# piper = giọng chạy trên máy (0,2s/câu)  | browser = giọng Chrome
ANNA_TTS=edge
# Giọng piper: vi_VN-vais1000-medium hoặc vi_VN-25hours_single-low
ANNA_PIPER_VOICE=vi_VN-vais1000-medium
